{
  "name": "dotfight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "phone": "vite --host \"${PHONE_HOST:?set PHONE_HOST to this machine's address}\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "share-art": "node scripts/share-art.mjs",
    "rules-art": "node scripts/rules-page.mjs",
    "lab": "node --import ./scripts/ts-resolve.mjs scripts/rules-lab.ts",
    "prepare": "node scripts/install-hooks.mjs",
    "lint": "biome lint --error-on-warnings .",
    "test:scripts": "node --test scripts/pr-gates/pr-gates.test.mjs scripts/privacy/privacy-scan.test.mjs scripts/hooks.test.mjs scripts/guarded-browser.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@upstash/redis": "^1.39.0"
  }
}
